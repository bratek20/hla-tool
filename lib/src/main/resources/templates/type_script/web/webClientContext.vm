namespace ${moduleName}.Web {
    export function config(): ${moduleName}WebClientConfig {
        return new ${moduleName}WebClientConfig(
            HttpClientConfig.create(
                EnvVars.Api.Get(new VariableName($baseUrl)),
                $serverName,
#if($auth)
                Optional.of(new SecretKey($auth))
#else
                Optional.empty()
#end
            )
        )
    }
}

